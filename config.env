# Machine-specific settings. Edit before running ./setup.sh.

N=5                     # parallel EPOS instances (~17 GB RAM each: N = (RAM_GB - 8) / 17)
DATA_DIR=               # REQUIRED: big disk for output, e.g. /media/Students/aliu
DATASET=auau200-7       # subfolder of DATA_DIR that collects finished ROOT files
INTERVAL=7h             # how often the scheduler checks for finished runs

# Usually fine as is
INSTALL_DIR="$REPO_DIR/install"          # dependencies + EPOS build (~6 GB)
EPOS_TARBALL="$REPO_DIR/epos4.0.3.tar"   # obtained from the EPOS authors
JOBS=$(nproc)                            # parallel compile jobs
